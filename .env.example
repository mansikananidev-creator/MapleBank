# Copy this file to .env before running `docker compose up` to override the local-dev
# defaults baked into docker-compose.yml. Nothing here is required to get the app
# running - defaults let it start with zero configuration - but you should set your
# own JWT_SECRET and DB_PASSWORD for anything beyond a local demo.

# MySQL root password (also used by the backend to connect).
DB_PASSWORD=changeme

# RabbitMQ login (also used by the backend to connect). guest/guest is RabbitMQ's own
# out-of-the-box default - fine for local demo use, override for anything real.
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# HS256 signing key for JWTs. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional - enables real forgot/reset password emails via Gmail SMTP.
# See README "Optional - enable forgot/reset password emails" for how to get an
# app password. Leave blank to skip email delivery (the API still works the same).
MAIL_USERNAME=
MAIL_PASSWORD=

# Where the frontend runs - used to build the link inside password reset emails.
FRONTEND_URL=http://localhost:5173
